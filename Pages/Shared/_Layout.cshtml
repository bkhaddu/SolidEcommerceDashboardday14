<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SolidEcommerceDashboard</title>

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <!-- NAVBAR -->
    <header class="main-header">
        <nav class="main-nav">

            <div class="logo">
                <a asp-page="/Index">E-Commerce</a>
            </div>

            <div class="nav-links">

                <a asp-page="/Index">Home</a>

                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-page="/Products">Products</a>
                }

                <a asp-page="/Cart">Cart</a>
                <a asp-page="/Orders">Orders</a>

                @if (Context.Session.GetString("UserEmail") == null)
                {
                    <a asp-page="/Account/Login">Login</a>
                    <a asp-page="/Account/Register">Register</a>
                }
                else
                {
                    <span class="user-name">
                        Hello, @Context.Session.GetString("UserName")
                    </span>

                    <a asp-page="/Account/Logout" class="logout-btn">
                        Logout
                    </a>
                }

            </div>

        </nav>
    </header>

    <!-- BODY -->
    <div class="main-container">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
        <p>© 2026 Solid Ecommerce Dashboard</p>
    </footer>

</body>
</html>